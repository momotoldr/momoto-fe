{
  "name": "photobooth-online",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:staging": "tsc --noEmit && CLOUDFLARE_ENV=staging vite build --mode staging && node scripts/staging-noindex.mjs",
    "preview": "npm run build && wrangler dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:staging": "npm run build:staging && npx wrangler deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.3",
    "@radix-ui/react-slot": "^1.1.0",
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.441.0",
    "peerjs": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.7.5",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@eslint/js": "^9.11.0",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "sass": "^1.79.1",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0",
    "vite": "^6.1.0",
    "wrangler": "^4.120.1"
  }
}
