# The two backends. Each must list this app's origin in its own CORS_ORIGINS.
#
# momoto-core: auth, strips, payments, avatars, stats — every REST call except the two
# below. Also the origin relative avatar and strip image URLs resolve against.
VITE_API_URL=http://localhost:3001
# momoto-realtime: the Socket.io connection, POST/GET /rooms and GET /turn-credentials.
VITE_REALTIME_URL=http://localhost:3003
#
# Deprecated: VITE_SOCKET_URL, from when one backend served all of the above. Still read
# as the fallback for BOTH variables, so a build that only sets it sends everything to
# that one host.

# Google OAuth client id for "Sign in with Google" (Google Cloud console →
# Credentials → OAuth client). Must match the backend's GOOGLE_CLIENT_ID. Leave
# unset to hide the Google button (email/password still works).
# VITE_GOOGLE_CLIENT_ID=

# PeerJS broker configuration. Unset falls back to the public PeerJS cloud broker,
# which rate-limits — fine for a quick try, not for production. Point these at the
# self-hosted broker in ../momoto-peer instead (values below match its defaults).
# In production: the deployed broker host, port 443, path /, secure true.
# VITE_PEERJS_HOST=localhost
# VITE_PEERJS_PORT=9000
# VITE_PEERJS_PATH=/
# VITE_PEERJS_SECURE=false

# WebRTC ICE servers (NAT traversal for the P2P video call).
# STUN: comma-separated; defaults to Google's public STUN if unset.
# VITE_STUN_URLS=stun:stun.l.google.com:19302
# TURN (relays media when a direct connection fails): set ALL THREE to enable.
# In production prefer short-lived credentials minted server-side over a static one,
# since VITE_* values are inlined into the public client bundle.
# VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_USERNAME=turn_user
# VITE_TURN_CREDENTIAL=[REDACTED_TURN_CREDENTIAL]

# ── Payments ──────────────────────────────────────────────────────────────────
# Payments. Checkout is Core API (server-to-server), so the frontend holds no Midtrans
# credentials — only this flag and the display price, which must equal the backend's
# STRIP_PRINT_PRICE_IDR.
# VITE_PAYMENTS_ENABLED=true
# VITE_STRIP_PRINT_PRICE_IDR=8999# Payments. Checkout is Core API (server-to-server), so the frontend holds no Midtrans
# credentials — only this flag and the display price, which must equal the backend's
# STRIP_PRINT_PRICE_IDR.
# VITE_PAYMENTS_ENABLED=true
# VITE_STRIP_PRINT_PRICE_IDR=8999

# ── Strip storage ─────────────────────────────────────────────────────────────
# How many strips one user may keep at a time. Today this bounds the signed-out
# cache in IndexedDB (full-res PNGs living in the visitor's browser); the server-
# side cap on POST /strips reads the backend's own STRIP_MAX_ITEMS. Set the two to
# the same number, or a guest fills their device with strips the cart then refuses.
# VITE_STRIP_MAX_ITEMS=5

# ── Closed beta ───────────────────────────────────────────────────────────────
# Moves /photobooth and /room/:roomId behind the login wall, so no one can start or
# join a session without an account. Accounts are seeded by hand (backend: `npm run
# seed:testers`) and signup is shut off with the backend's INVITE_ONLY, which makes
# "signed in" mean "invited". Unset or anything but `true` = OFF (public booth).
#
# Also shows a closed-beta banner above the login form, and hides the Google sign-in
# button: seeded accounts carry no email or googleId, so Google could never match one.
# VITE_BETA_MODE=true

# ── Group mode ────────────────────────────────────────────────────────────────
# Offers a third booth mode: one room, 2–4 people, all on camera (PLAN-group-mode.md).
# Unset or anything but `true` = OFF — the Group card is hidden and `?mode=group` is
# refused, leaving Solo and Date untouched.
#
# This flag only controls what the client OFFERS. The seat count is enforced by the
# backend's ROOM_CAPACITY_MAX (default 2), which refuses the third join regardless —
# raise both, or the Group card mints rooms nobody can be the third person in.
# VITE_GROUP_MODE_ENABLED=true

# ── Strip backdrops ───────────────────────────────────────────────────────────
# Offers a Background tab on the arrange screen: the people in each cut are cut out
# on-device (ISNet via onnxruntime-web) and placed in front of a chosen backdrop.
# Unset or anything but `true` = OFF — the tab is hidden, any stored backdrop is read
# as none, and `npm run dev` / `build` / `build:staging` don't stage the ~73 MB model
# and runtime into public/segmentation/, so nothing extra is deployed.
# VITE_BACKDROPS_ENABLED=true
